{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/itinerary.js": { "maxDuration": 60 },
    "api/places.js": { "maxDuration": 30 },
    "api/route.js": { "maxDuration": 30 },
    "api/weather.js": {
      "maxDuration": 30
    }
  }
}
