# Optional. Enables AI itinerary generation through Groq (server-side only).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Independent repository critic for the local audit dashboard.
AUDIT_CRITIC_MODEL=openai/gpt-oss-120b
# Optional. Server-side destination research through Tavily.
TAVILY_API_KEY=
# Optional for local PowerShell/Node servers. For Vercel, set this in
# Project Settings > Environment Variables (never prefix it with VITE_).
OPENWEATHER_API_KEY=
# Optional server port (defaults to 8787)
PORT=8787
